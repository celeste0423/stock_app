[Unit]
Description=Build and send %i market-close leader report
After=network-online.target stock-muse-app.service
Wants=network-online.target
Requires=stock-muse-app.service

[Service]
Type=oneshot
User=stockleader
Group=stockleader
WorkingDirectory=/opt/stock-leader/app
EnvironmentFile=/etc/stock-leader.env
Environment=HOME=/var/lib/stock-leader
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/bash -lc 'for i in {1..60}; do curl -fsS http://127.0.0.1:${STOCK_APP_PORT:-8124}/api/health >/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/bin/bash -lc 'exec /opt/stock-leader/venv/bin/python tools/muse_market_close_job.py --market %i --server-url "http://127.0.0.1:${STOCK_APP_PORT:-8124}"'
TimeoutStartSec=1h
