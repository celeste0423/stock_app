#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "PowerShell not found for pre-commit hook." >&2
  exit 1
fi

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(frontend/.*\.(js|html|css)|backend/.*\.py|tools/.*\.ps1|WORKFLOW\.md|\.editorconfig|\.gitattributes)$' || true)"

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

exec "$PS_BIN" -ExecutionPolicy Bypass -File "$REPO_ROOT/tools/check_frontend.ps1" -ProjectRoot "$REPO_ROOT" -Files $STAGED_FILES
